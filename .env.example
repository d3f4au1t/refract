NODE_ENV=development
HOST=127.0.0.1
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
DATABASE_PATH=.data/refract.sqlite
# A sending API key and an address on your verified Resend domain:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Google Cloud Console > OAuth client > Web application.
# Add https://YOUR_DOMAIN/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub Settings > Developer settings > OAuth Apps.
# Callback: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
